# Copy to .env and fill in your own values. Never commit the real .env.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3307/kotakide"

# Authentication / sessions
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial admin (local setup only; do not reuse in production)
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Email
# MAIL_PROVIDER: "log" (dev) or "smtp" (production)
MAIL_PROVIDER="log"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
ADMIN_NOTIFICATION_EMAILS=""

# Storage
# STORAGE_DRIVER: "local" (dev) or "s3" (production, S3-compatible)
STORAGE_DRIVER="local"
STORAGE_BUCKET=".data/storage"
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Analytics (optional; "none" to disable)
ANALYTICS_PROVIDER="none"
ANALYTICS_ID=""

# Scheduled publishing guard
CRON_SECRET=""