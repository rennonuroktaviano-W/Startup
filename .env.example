# Copy to .env and fill in your own values. Never commit the real .env.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/kotakide"

# Authentication / sessions
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial admin (local setup only; do not reuse in production)
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Email
# MAIL_PROVIDER: "log" (dev) or "smtp" (production)
MAIL_PROVIDER="log"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
ADMIN_NOTIFICATION_EMAILS=""

# Storage
# STORAGE_DRIVER: "local" (dev) or "s3" (production, S3-compatible)
STORAGE_DRIVER="local"
STORAGE_BUCKET=".data/storage"
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Analytics (optional; "none" to disable)
ANALYTICS_PROVIDER="none"
ANALYTICS_ID=""

# Scheduled publishing guard
CRON_SECRET=""

# ---------------------------------------------------------------
# Production deployment (Vercel)
# ---------------------------------------------------------------
# Set these in Vercel Project Settings > Environment Variables (Production).
# Only vars you change need to be set; managed ones are marked "(managed)".
#
#   DATABASE_URL            -> hosted MySQL URL, e.g. mysql://user:pass@host:3306/db?ssl-mode=REQUIRED
#   AUTH_SECRET             -> run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   NEXT_PUBLIC_SITE_URL    -> your Vercel domain, e.g. https://<project>.vercel.app
#   MAIL_PROVIDER           -> "smtp" (keeps notification emails working)
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / MAIL_FROM / ADMIN_NOTIFICATION_EMAILS
#   STORAGE_DRIVER          -> "s3" (local disk does NOT persist on serverless)
#   STORAGE_BUCKET          -> S3-compatible bucket name
#   STORAGE_REGION / STORAGE_ENDPOINT / STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY
#   ANALYTICS_PROVIDER      -> optional; "none" to disable
#   CRON_SECRET             -> guard for /api/cron/publish (used by vercel.json crons)
#
# Post-deploy: run migrations + seed the first admin once DATABASE_URL is live
# (npm run db:deploy && npm run db:seed with that DATABASE_URL set).
# INITIAL_ADMIN_EMAIL/PASSWORD are local only and never reused in production.