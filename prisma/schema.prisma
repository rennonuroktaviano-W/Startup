generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CONTENT_EDITOR
  SALES
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ContentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ProjectType {
  CLIENT
  CONCEPT
}

enum TestimonialConsent {
  PENDING_PERMISSION
  APPROVED
  DENIED
}

enum TestimonialStatus {
  PENDING_PERMISSION
  PUBLISHED
  HIDDEN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  SPAM
}

enum PreferredContact {
  WHATSAPP
  EMAIL
  PHONE
  OTHER
}

enum NavigationType {
  INTERNAL
  EXTERNAL
}

enum FAQCategory {
  GENERAL
  SERVICE
  PROCESS
  PRICING
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum PageType {
  HOME
  SERVICES
  WORK
  ABOUT
  PROCESS
  INSIGHTS
  CONTACT
  LEGAL
  GENERIC
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(CONTENT_EDITOR)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions    Session[]
  createdRevisions ContentRevision[] @relation("RevisionAuthor")
  inquiryNotes InquiryNote[]
  assignedInquiries Inquiry[]
  blogPosts BlogPost[]
  inquiryActivities InquiryActivity[]
  auditLogs AuditLog[]
}

model Session {
  id               String   @id @default(cuid())
  tokenHash        String   @unique
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  revokedAt        DateTime?
  ipMasked         String?
  userAgentSummary String?
  createdAt        DateTime @default(now())

  @@index([userId])
}

model PreviewToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  entityType String
  entityId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json
  group     String   @default("general")
  isPublic  Boolean  @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  pageType         PageType    @default(GENERIC)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  ogMediaId        String?
  noIndex          Boolean     @default(false)
  structuredData   Json?
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  sections PageSection[]
}

model PageSection {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionType String
  variant     String   @default("default")
  contentJson Json
  styleJson   Json?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageId, sortOrder])
}

model ContentRevision {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  snapshotJson  Json
  versionNumber Int
  createdBy     String?
  author        User?    @relation("RevisionAuthor", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
}

model Service {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String
  bodyJson         Json
  targetClient     String?
  problemsSolved   Json?
  priceMode        String        @default("HIDDEN")
  startingPrice    Int?
  priceLabel       String?
  timelineText     String?
  status           ContentStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  sortOrder        Int           @default(0)
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  ogMediaId        String?
  noIndex          Boolean       @default(false)
  structuredData   Json?
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  deliverables ServiceDeliverable[]
  projectServices ProjectService[]
  faqs FAQ[]
  inquiries Inquiry[]
}

model ServiceDeliverable {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int     @default(0)

  @@index([serviceId, sortOrder])
}

model Client {
  id          String   @id @default(cuid())
  name        String   @unique
  logoMediaId String?
  websiteUrl  String?
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects     Project[]
  testimonials Testimonial[]
}

model Project {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  projectType      ProjectType   @default(CONCEPT)
  clientId         String?
  client           Client?       @relation(fields: [clientId], references: [id])
  industry         String?
  year             Int?
  summary          String?
  challengeJson    Json
  goalsJson        Json
  approachJson     Json
  highlightsJson   Json?
  outcomeJson      Json
  coverMediaId     String?
  status           ContentStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  ogMediaId        String?
  noIndex          Boolean       @default(false)
  structuredData   Json?
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  projectServices ProjectService[]
  projectMedia    ProjectMedia[]
  projectMetrics  ProjectMetric[]
  testimonials    Testimonial[]
}

model ProjectService {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([projectId, serviceId])
  @@index([serviceId])
}

model ProjectMedia {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId       String
  media         MediaAsset @relation(fields: [mediaId], references: [id])
  layoutVariant String?
  caption       String?
  sortOrder     Int     @default(0)

  @@index([projectId, sortOrder])
}

model ProjectMetric {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label      String
  value      String
  unit       String?
  sourceNote String?
  sortOrder  Int     @default(0)

  @@index([projectId, sortOrder])
}

model Testimonial {
  id            String             @id @default(cuid())
  clientId      String?
  client        Client?            @relation(fields: [clientId], references: [id])
  projectId     String?
  project       Project?           @relation(fields: [projectId], references: [id])
  personName    String
  jobTitle      String?
  companyName   String?
  quote         String
  avatarMediaId String?
  consentStatus TestimonialConsent @default(PENDING_PERMISSION)
  status        TestimonialStatus  @default(PENDING_PERMISSION)
  sortOrder     Int                @default(0)
  publishedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  roleTitle   String
  bio         String?
  photoMediaId String?
  socialJson  Json?
  status      UserStatus @default(ACTIVE)
  sortOrder   Int     @default(0)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id                String        @id @default(cuid())
  title             String
  slug              String        @unique
  excerpt           String?
  bodyJson          Json
  featuredMediaId   String?
  authorId          String?
  author            User?         @relation(fields: [authorId], references: [id])
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?
  scheduledAt       DateTime?
  readingMinutes    Int?
  metaTitle         String?
  metaDescription   String?
  canonicalUrl      String?
  ogMediaId         String?
  noIndex           Boolean       @default(false)
  structuredData    Json?
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  categories PostCategory[]
  tags       PostTag[]
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts PostCategory[]
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts PostTag[]
}

model PostCategory {
  id         String       @id @default(cuid())
  postId     String
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@index([categoryId])
}

model PostTag {
  id      String  @id @default(cuid())
  postId  String
  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId   String
  tag     BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([tagId])
}

model FAQ {
  id          String       @id @default(cuid())
  question    String
  answerJson  Json
  category    FAQCategory  @default(GENERAL)
  serviceId   String?
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  pageId      String?
  status      ContentStatus @default(PUBLISHED)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Inquiry {
  id                String          @id @default(cuid())
  referenceNumber   String          @unique
  name              String
  companyName       String?
  email             String
  whatsapp          String?
  preferredContact  PreferredContact @default(WHATSAPP)
  serviceId         String?
  service           Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  projectType       String?
  goal              String?
  description       String?
  scopeJson         Json?
  assetsStateJson   Json?
  targetDate        String?
  budgetRange       String?
  consentAt         DateTime        @default(now())
  status            LeadStatus      @default(NEW)
  isRead            Boolean         @default(false)
  assigneeId        String?
  assignee          User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  lostReason        String?
  source            String?         @default("website")
  utmJson           Json?
  lastContactedAt   DateTime?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  notes       InquiryNote[]
  activities  InquiryActivity[]
  attachments InquiryAttachment[]

  @@index([status])
  @@index([createdAt])
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model InquiryActivity {
  id          String   @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  action      String
  metadataJson Json?
  createdAt   DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model InquiryAttachment {
  id                String     @id @default(cuid())
  inquiryId         String
  inquiry           Inquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  mediaId           String?
  media             MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  privateStorageKey String
  originalName      String
  mimeType          String
  sizeBytes         Int
  createdAt         DateTime   @default(now())
}

model MediaAsset {
  id           String    @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  storageKey   String
  publicUrl    String?
  kind         MediaKind @default(OTHER)
  altText      String?
  caption      String?
  credit       String?
  focalPointJson Json?
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projectMedia ProjectMedia[]
  inquiryAttachments InquiryAttachment[]
}

model NavigationItem {
  id           String         @id @default(cuid())
  label        String
  href         String
  type         NavigationType @default(INTERNAL)
  iconKey      String?
  isCta        Boolean        @default(false)
  isVisible    Boolean        @default(true)
  desktopOrder Int            @default(0)
  mobileOrder  Int            @default(0)
  desktopOnly  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Redirect {
  id            String   @id @default(cuid())
  sourcePath    String   @unique
  destinationUrl String
  statusCode    Int      @default(301)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationSetting {
  id           String   @id @default(cuid())
  eventKey     String   @unique
  recipientsJson Json
  channel      String   @default("email")
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id               String    @id @default(cuid())
  actorId          String?
  actor            User?     @relation(fields: [actorId], references: [id])
  action           String
  entityType       String?
  entityId         String?
  summaryJson      Json?
  ipMasked         String?
  userAgentSummary String?
  createdAt        DateTime  @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}