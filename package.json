{
  "name": "kotakide-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts\\db-start.ps1",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts\\db-stop.ps1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/extension-link": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/extension-text-align": "3.31.0",
    "@tiptap/extension-underline": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "argon2": "^0.41.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^11.0.0",
    "next": "16.3.4",
    "nodemailer": "^9.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.13.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
